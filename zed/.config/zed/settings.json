// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)


{
  "buffer_font_size": 14.0,
  "terminal": {
    
  },
  "window_decorations": "server",
  "title_bar": {
    "show_branch_status_icon": false
  },
  "edit_predictions": {
    "disabled_globs": [
      "..."
    ],
    "allow_data_collection": "yes",
    "copilot": {
      "prediction_debounce": 0,
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot"
  },

  "cli_default_open_behavior": "new_window",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Propo",

  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "plan",
        "model": "opencode/nemotron-3-ultra-free"
      },
      "type": "registry"
    }
  },

  "scroll_sensitivity": 2.0,
  "debugger": {
    "button": false
  },

  "outline_panel": {
    "dock": "left"
  },

  "icon_theme": "JetBrains New UI Icons (Dark)",
  "collaboration_panel": {
    "button": false
  },

  "project_panel": {
    "dock": "left"
  },

  "agent": {
    "threads_sidebar": {
      "position": "right"
    },

    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },

  "ui_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "Vercel Dark",
    "dark": "Catppuccin Mocha"
  },

"theme_overrides": {
    "Catppuccin Mocha": {
      "status_bar.background": "#1e1e2e",
      "title_bar.background": "#1e1e2e",
      "title_bar.inactive_background": "#1a1a29",
      "toolbar.background": "#1e1e2e",
      "tab_bar.background": "#1e1e2e",
      "tab.inactive_background": "#1a1a29",
      "scrollbar.track.background": "#1a1a29",
      "panel.background": "#1a1a29",
      "surface.background": "#1a1a29",
    }
  }
}
