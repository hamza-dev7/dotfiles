// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)


{
  "inlay_hints": {
    "enabled": true
  },
  "languages": {
    "Python": {
      "show_edit_predictions": true
    }
  },
  "buffer_font_size": 14.0,
  "terminal": {

  },
  "window_decorations": "server",
  "title_bar": {
    "show_branch_status_icon": false
  },
  "edit_predictions": {
    "codestral": {
      "model": "codestral-latest"
    },
    "open_ai_compatible_api": {
      "prompt_format": "code_gemma",
      "model": "google/gemma-4-26b-a4b-it:free",
      "api_url": "https://openrouter.ai/api/v1/completions"
    },
    "disabled_globs": [
      "..."
    ],
    "allow_data_collection": "no",
    "copilot": {
      "prediction_debounce": 0,
      "enable_next_edit_suggestions": true
    },
    "provider": "codestral"
  },

  "cli_default_open_behavior": "new_window",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Propo",

  "agent_servers": {
    "opencode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
      "default_config_options": {
        "mode": "plan",
        "model": "opencode/deepseek-v4.1-flash-free"
      },
    }
  },

  "scroll_sensitivity": 2.0,
  "debugger": {
    "button": false
  },

  "outline_panel": {
    "dock": "left"
  },

  "icon_theme": "Colored Zed Icons Theme Dark",
  "collaboration_panel": {
    "button": false
  },

  "project_panel": {
    "dock": "left"
  },

  "agent": {
    "threads_sidebar": {
      "position": "right"
    },

    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },

  "ui_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "Vercel Dark",
    "dark": "Catppuccin Mocha"
  },

  "theme_overrides": {
    "Catppuccin Mocha": {
      "status_bar.background": "#1e1e2e",
      "title_bar.background": "#1e1e2e",
      "title_bar.inactive_background": "#1a1a29",
      "toolbar.background": "#1e1e2e",
      "tab_bar.background": "#1e1e2e",
      "tab.inactive_background": "#1a1a29",
      "scrollbar.track.background": "#1a1a29",
      "panel.background": "#1a1a29",
      "surface.background": "#1a1a29",
    }
  },

  "auto_install_extensions": {
    "aura-theme": true,
    "catppuccin": true,
    "catppuccin-blur": true,
    "catppuccin-black-theme": true,
    "modest-dark": true,
    "one-dark-pro-max": true,
    "oxocarbon": true,
    "rose-pine-theme": true,
    "tokyo-night": true,
    "vercel-carbon-theme": true,

    "colored-zed-icons-theme": true,
    "jetbrains-new-ui-icons": true,
    "material-icon-theme": true,

    "desktop": true,
    "kdl": true,
    "latex": true,
    "latex-snippets": true,
    "lua": true,
    "rasi": true,
    "toml": true,
    "color-highlight": true,
    "html": true
  }
}
